//
// ─── DATABASE SCHEMA (GETIC + BETTER AUTH, MULTI-TENANT) ────────────────────
//
// TWO DATA PLANES:
//   1. Better Auth contract tables (User/Session/Account/Verification +
//      Organization/Member/Invitation for the organization plugin). Field
//      names match the plugin's schema exactly — don't rename them.
//   2. App tables (Ticket/Note). Ticket carries `organizationId` — the tenant
//      wall. Every read/write in lib/rbac.ts filters on the session's active
//      organization, so company A's data is never visible to company B.
//
// After editing: `npx prisma migrate dev` (dev) / `migrate deploy` (prod),
// then `npx prisma generate` — client output in app/generated/prisma.

generator client {
  provider = "prisma-client"
  // 👇 Custom output: generated types in app/generated/prisma (checked in)
  output = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═════════════════════════════════════════════════════════════════════════
// ─── APP TABLES (tenant-scoped) ───────────────────────────────────────────
// ═════════════════════════════════════════════════════════════════════════

// 👇 Ticket states as a NATIVE Postgres enum — invalid values are rejected by
//    the DB itself. UI tab filters map to these exact strings ("open" → OPEN,
//    "in_progress" → IN_PROGRESS, "closed" → CLOSED — _data/data-table.tsx).
enum Status {
  OPEN
  IN_PROGRESS
  CLOSED
}

// 👇 Ticket urgency. The form dialog and the table's Priority column map to
//    these exact strings; sorting is by declared rank (LOW < MEDIUM < HIGH
//    < URGENT), not alphabetically — see columns.tsx.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// 👇 ACTIVITY LOG event kinds. Written by lib/activity.ts from auth hooks
//    (invites) and API routes (tickets/members). ORG_* rows carry the
//    organizationId (visible to every member of that room); personal rows
//    (EMAIL_* …) carry only the actor and show on the notifications page.
enum ActivityType {
  // invites & joining
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_CANCELED
  JOINED_VIA_CODE
  // room/team
  ORG_CREATED
  ROLE_CHANGED
  MEMBER_REMOVED
  // desk
  TICKET_CREATED
  TICKET_ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
}

// 👇 WHAT: One support ticket. `ticketId` is the human code ("TKT-001");
//    `id` is the numeric PK used to build it (POST /api/tickets pads it).
// 👇 TENANT: organizationId is NOT NULL — a ticket always belongs to exactly
//    one org; every query filters by it (the WHERE clause IS the wall).
model Ticket {
  id            Int      @id @default(autoincrement())
  ticketId      String   @unique @default("")
  customerName  String
  customerEmail String
  subject       String
  description   String
  status        Status   @default(OPEN)
  priority      Priority @default(MEDIUM)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 👇 ASSIGNEE: nullable — unassigned tickets sit in the shared queue until
  //    someone takes them. Must be a Member of the SAME org (validated in the
  //    API routes before the write — the tenant wall again). SetNull on user
  //    delete: the ticket survives, it just goes back to the queue.
  assigneeId    String?
  assignee      User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // 👇 THE TENANT WALL: set from the session's active organization on create,
  //    filtered on every read. Cascade on org delete (whole room removed).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  notes Note[] // 👈 back-reference: ticket.notes lists all attached notes

  @@index([organizationId, createdAt])
}

// 👇 Internal comment attached to a ticket. Tenancy is INHERITED from the
//    ticket (no own organizationId): you can only reach a note through its
//    ticket, and tickets are org-scoped — single wall, one enforcement point.
model Note {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  notesText String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ═════════════════════════════════════════════════════════════════════════
// ─── BETTER AUTH CORE TABLES ──────────────────────────────────────────────
// ═════════════════════════════════════════════════════════════════════════

// 👇 App-wide RBAC (ADMIN manages users/roles, AGENT works tickets) — on the
//    user row for the Admin plugin's global checks (lib/access.ts).
//    ORG-SCOPED roles live separately on Member.role (OWNER | ADMIN | AGENT
//    within a single org) — a user can be ADMIN in one org, AGENT in another.
enum Role {
  ADMIN
  AGENT
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(AGENT)
  // 👇 Admin-plugin fields (ban system) — required by the plugin's schema check
  banned        Boolean  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  memberships     Member[]
  invitationsSent Invitation[] @relation("inviter")
  presence        Presence?
  assignedTickets Ticket[]     @relation("TicketAssignee")
}

// WHO'S ONLINE: one row per user, refreshed by a 25s heartbeat from any
// page they have open (components/online-agents.tsx). "Online" = lastSeenAt
// within 60s AND scoped to their ACTIVE organization, so the avatar group
// only ever shows teammates of the room you are working in.
model Presence {
  userId         String   @id
  organizationId String
  lastSeenAt     DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, lastSeenAt])
}

model Session {
  id         String   @id
  expiresAt  DateTime
  token      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ipAddress  String?
  userAgent  String?
  // 👇 Admin-plugin field (impersonation audit trail)
  impersonatedBy String?
  // 👇 Organization plugin: the ACTIVE org for this session ("which room am
  //    I in"). The plugin reads/writes it directly — setActive switches it.
  activeOrganizationId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════════
// ─── ORGANIZATIONS (multi-tenant "rooms") ─────────────────────────────────
// Company signs up → first user becomes ADMIN and auto-creates their org.
// Agents join via invite (≤10 ADMIN + ≤1000 AGENT per org — enforced in
// lib/auth.ts's sendInvitationEmail BEFORE the invite row is written).
// Every ticket row carries organizationId; queries ALWAYS filter by the
// session's active org — that filter is the tenant wall.
// ═════════════════════════════════════════════════════════════════════════

// 👇 Better Auth organization plugin contract tables (field names are the
//    plugin's schema — don't rename; regenerate via @better-auth/cli if the
//    config in lib/auth.ts changes shape).
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  // JOIN-BY-CREDENTIALS: a second way into a room besides email invites.
  // joinCode is the public "room id" (shown to members, shareable);
  // joinPasswordHash is a scrypt hash (better-auth/crypto hashPassword -
  // same format the sign-in flow uses). Privacy rule: the room NAME and its
  // member list are only returned when BOTH code and password are correct -
  // wrong/missing password gets a generic "not found", never a name leak.
  joinCode         String  @unique
  joinPasswordHash String?

  members     Member[]
  invitations Invitation[]
  tickets     Ticket[]
  activities  Activity[]
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  // 👇 ORG-SCOPED role: "OWNER" | "ADMIN" | "AGENT" (org creator gets OWNER
  //    via creatorRole). Distinct from the global User.role — privilege is
  //    per-tenant: OWNER in one org, plain AGENT in another.
  role           String   @default("AGENT")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// 👇 WHAT: one row per noteworthy event, surfaced on /notifications.
// WHO SEES WHAT: rows with organizationId are visible to every member of
// that room (org-scoped news feed); rows with only actorId are personal
// (e.g. "you were invited to X"). READ-ONLY from the app's perspective —
// nothing updates/deletes rows; the page shows the last 100.
model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  title          String
  description    String
  // 👇nullable: INVITE_SENT etc. are org events; a future personal event
  //   has none and is only visible to its actor.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actorName      String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String   @default("AGENT")
  status         String   @default("pending") // pending | accepted | rejected | canceled
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
}
