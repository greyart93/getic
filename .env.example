# ─── DATABASE ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon in prod). Prisma + Better Auth share it.
DATABASE_URL=

# ─── BETTER AUTH (auth) ──────────────────────────────────────────────────────
# Session/HMAC secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app. Local dev: http://localhost:3000
# Prod: https://your-app.vercel.app  (must match OAuth callback registrations!)
BETTER_AUTH_URL=
# First-admin bootstrap: whoever signs up with THIS email becomes ADMIN.
# Leave empty to disable (everyone is AGENT until an admin promotes them).
FIRST_ADMIN_EMAIL=

# ─── OAUTH PROVIDERS ─────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials → OAuth client (Web)
#   Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → OAuth App
#   Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── EMAIL ──────────────────────────────────────────────
# lib/email.tsx tries rails in order: Resend HTTPS → SMTP → console log.
#
# 1) RESEND (recommended for Vercel — raw outbound SMTP is blocked on
#    serverless, so SMTP creds alone fail silently there). Plain HTTPS API.
#    Key: https://resend.com/api-keys · sender domain must be verified in
#    the Resend dashboard (or use onboarding@resend.dev while testing).
RESEND_API_KEY=
#
# 2) SMTP fallback (dev / self-host). Any provider works (Gmail
#    app-password, Mailtrap, Postmark, SES…). Without EITHER rail the
#    senders in lib/email.tsx log to the server console instead of
#    sending - every mail flow still completes (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "secure" = implicit TLS (port 465). Leave 587 + secure=false for STARTTLS.
SMTP_SECURE=false
# Verified sender identity shown to recipients, e.g.:
# EMAIL_FROM="Getic <noreply@yourdomain.com>"
EMAIL_FROM=
# Templates live in emails/ (react-email) - preview with: pnpm email:dev
# Smoke-test the pipeline with: pnpm email:test -- you@example.com
